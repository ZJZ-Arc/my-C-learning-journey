{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build current file",
      "type": "process",
      // 用 gcc 转发器（自带 UTF-8/GBK 编码参数、-static、PATH/TEMP 兜底，
      // 以及「输出到中文路径」的兜底），这样 VS Code 各条编译路径行为一致。
      "command": "D:/runbank/tools/gcc-gbk.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}",
          "TEMP": "C:\\msys64\\tmp",
          "TMP": "C:\\msys64\\tmp",
          "TMPDIR": "C:\\msys64\\tmp"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "C: run current file (build first)",
      "type": "process",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}",
          "TEMP": "C:\\msys64\\tmp",
          "TMP": "C:\\msys64\\tmp",
          "TMPDIR": "C:\\msys64\\tmp"
        }
      },
      "dependsOn": "C: build current file",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false,
        "echo": true,
        "focus": true
      },
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
